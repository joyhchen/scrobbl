---
import type { IPodColorTheme, MonthlyPlaylist } from '../lib/types';

interface Props {
  playlists: MonthlyPlaylist[];
  initialIndex?: number;
  initialTheme?: IPodColorTheme;
}

const { playlists, initialIndex = 0, initialTheme = 'aqua' } = Astro.props;
const initialPlaylist = playlists[initialIndex];
---

<section class="ipod-stage" aria-label="iPod playlist viewer">
  <div class="ipod-ground-shadow" aria-hidden="true"></div>

  <div class="ipod-3d-rig" id="ipod-3d-rig" data-theme={initialTheme}>
    <div class="ipod-chrome-back" aria-hidden="true"></div>
    <div class="ipod-bevel-mid" aria-hidden="true"></div>

    <div class="ipod-body" id="ipod-body">
      <div class="ipod-screen-bezel">
        <div class="ipod-lcd">
          <div class="ipod-lcd-glare" aria-hidden="true"></div>

          <header class="ipod-topbar">
            <span class="ipod-topbar-left" id="ipod-topbar-left" aria-hidden="true">‹</span>
            <span class="ipod-topbar-title" id="ipod-topbar-title">
              {initialPlaylist ? initialPlaylist.label : 'Playlists'}
            </span>
            <span class="ipod-battery" title="99%" aria-label="Battery 99%">
              <span class="ipod-battery-shell">
                <span class="ipod-battery-fill"></span>
              </span>
              <span class="ipod-battery-nub"></span>
            </span>
          </header>

          <div class="ipod-screen-viewport">
            <div class="ipod-view" id="ipod-view-playlists" data-state="left" aria-hidden="true">
              <div class="ipod-list-wrap">
                <ul class="ipod-list" id="ipod-playlists-list" role="listbox" aria-label="All playlists">
                  {playlists.map((pl, idx) => (
                    <li
                      class:list={['ipod-menu-row', idx === initialIndex && 'is-selected']}
                      data-playlist-idx={idx}
                      role="option"
                      aria-selected={idx === initialIndex ? 'true' : 'false'}
                    >
                      <span class="ipod-menu-row-title">{pl.label}</span>
                      <span class="ipod-menu-row-meta">
                        <span>{pl.trackCount}</span>
                        <span class="ipod-chevron" aria-hidden="true">›</span>
                      </span>
                    </li>
                  ))}
                </ul>
                <div class="ipod-scrollbar-track" aria-hidden="true">
                  <div class="ipod-scrollbar-thumb" id="ipod-playlists-thumb"></div>
                </div>
              </div>
            </div>

            <div class="ipod-view" id="ipod-view-tracks" data-state="active" aria-hidden="false">
              <div class="ipod-subheader">
                <span id="ipod-track-count">
                  {initialPlaylist ? `${initialPlaylist.trackCount} songs` : '0 songs'}
                </span>
                <span id="ipod-track-total-time">
                  {initialPlaylist?.totalDurationText ?? ''}
                </span>
              </div>
              <div class="ipod-list-wrap">
                <ul class="ipod-list" id="ipod-tracks-list" role="listbox" aria-label="Playlist tracks">
                  {initialPlaylist?.tracks.map((track, idx) => (
                    <li
                      class:list={['ipod-track-row', idx === 0 && 'is-selected']}
                      data-track-idx={idx}
                      role="option"
                      aria-selected={idx === 0 ? 'true' : 'false'}
                    >
                      <div class="ipod-track-top">
                        <span class="ipod-track-title">{track.title}</span>
                        <span class="ipod-track-duration">{track.durationText}</span>
                      </div>
                      <div class="ipod-track-artist">{track.artistText}</div>
                    </li>
                  ))}
                </ul>
                <div class="ipod-scrollbar-track" aria-hidden="true">
                  <div class="ipod-scrollbar-thumb" id="ipod-tracks-thumb"></div>
                </div>
              </div>
            </div>

            <div class="ipod-view ipod-detail-view" id="ipod-view-detail" data-state="right" aria-hidden="true">
              <div class="ipod-video-stage" id="ipod-video-stage">
                <div class="ipod-yt-host" id="ipod-yt-host"></div>

                <div class="ipod-video-fallback" id="ipod-video-fallback" data-visible="false" aria-live="polite">
                  <div class="ipod-fallback-art" aria-hidden="true">
                    <span class="ipod-detail-art-month" id="ipod-detail-art-month">
                      {initialPlaylist?.monthShort ?? ''}
                    </span>
                    <span class="ipod-detail-art-year" id="ipod-detail-art-year">
                      {initialPlaylist?.year ?? ''}
                    </span>
                  </div>
                  <div class="ipod-fallback-title" id="ipod-detail-title">
                    {initialPlaylist?.tracks[0]?.title ?? ''}
                  </div>
                  <div class="ipod-fallback-subtitle" id="ipod-detail-playlist">
                    {initialPlaylist?.label ?? ''}
                  </div>
                  <div class="ipod-fallback-status" id="ipod-fallback-status">
                    Video unavailable to embed
                  </div>
                  <div class="ipod-fallback-actions">
                    <a
                      class="ipod-fallback-link"
                      id="ipod-fallback-link"
                      href="https://www.youtube.com"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Open on YouTube ↗
                    </a>
                    <button type="button" class="ipod-fallback-skip" id="ipod-fallback-skip">
                      Next ›
                    </button>
                  </div>
                </div>
              </div>

              <div class="ipod-video-hud">
                <div class="ipod-video-meta">
                  <span class="ipod-video-artist" id="ipod-detail-artist">
                    {initialPlaylist?.tracks[0]?.artistText ?? ''}
                  </span>
                  <span class="ipod-video-counter" id="ipod-detail-counter">
                    1 of {initialPlaylist?.trackCount ?? 0}
                  </span>
                </div>
                <div class="ipod-scrubber-row">
                  <span class="ipod-scrubber-time" id="ipod-detail-elapsed">0:00</span>
                  <div
                    class="ipod-scrubber-track"
                    id="ipod-scrubber-track"
                    role="slider"
                    aria-label="Track progress"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="0"
                  >
                    <div class="ipod-scrubber-fill" id="ipod-scrubber-fill"></div>
                  </div>
                  <span class="ipod-scrubber-time" id="ipod-detail-duration">
                    {initialPlaylist?.tracks[0]?.durationText ? `-${initialPlaylist.tracks[0].durationText}` : '-0:00'}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ipod-wheel-area">
        <div
          class="ipod-click-wheel"
          id="ipod-click-wheel"
          role="group"
          aria-label="iPod click wheel"
        >
          <button
            type="button"
            class="wheel-btn wheel-btn-menu"
            id="wheel-btn-menu"
            aria-label="Menu — navigate back to playlists"
            title="MENU (Back)"
          >
            MENU
          </button>

          <button
            type="button"
            class="wheel-btn wheel-btn-prev"
            id="wheel-btn-prev"
            aria-label="Navigate up"
            title="Up / Previous"
          >
            <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor" aria-hidden="true">
              <rect x="0.5" y="1" width="2" height="10" rx="0.5" />
              <path d="M10 1.2L3.2 6L10 10.8V1.2Z" />
              <path d="M17.2 1.2L10.4 6L17.2 10.8V1.2Z" />
            </svg>
          </button>

          <button
            type="button"
            class="wheel-btn wheel-btn-next"
            id="wheel-btn-next"
            aria-label="Navigate down"
            title="Down / Next"
          >
            <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor" aria-hidden="true">
              <path d="M0.8 1.2L7.6 6L0.8 10.8V1.2Z" />
              <path d="M8 1.2L14.8 6L8 10.8V1.2Z" />
              <rect x="15.5" y="1" width="2" height="10" rx="0.5" />
            </svg>
          </button>

          <button
            type="button"
            class="wheel-btn wheel-btn-play"
            id="wheel-btn-play"
            aria-label="Play or pause track"
            title="Play / Pause"
          >
            <svg width="20" height="11" viewBox="0 0 20 11" fill="currentColor" aria-hidden="true">
              <path d="M1 1L8.8 5.5L1 10V1Z" />
              <rect x="11.5" y="1" width="2.6" height="9" rx="0.5" />
              <rect x="16" y="1" width="2.6" height="9" rx="0.5" />
            </svg>
          </button>

          <button
            type="button"
            class="wheel-center-btn"
            id="wheel-center-btn"
            aria-label="Select"
            title="Select"
          ></button>
        </div>
      </div>
    </div>
  </div>
</section>
