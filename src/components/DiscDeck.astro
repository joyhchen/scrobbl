---
import { formatDiscSlot } from '../lib/format';
import type { DiscPreset } from '../lib/types';
import DiscCard from './DiscCard.astro';

interface Props {
  /** Whole CD collection. The first six not marked `inChangerByDefault: false` start in the changer. */
  discs: DiscPreset[];
  initialDiscId?: string;
}

const { discs, initialDiscId = discs[0]?.id } = Astro.props;
const TOTAL_SLOTS = 6;
const startingLoadout = discs.filter((d) => d.inChangerByDefault !== false);
const slots = Array.from({ length: TOTAL_SLOTS }, (_, slotIdx) => ({
  slotIdx,
  slotNumber: String(slotIdx + 1).padStart(2, '0'),
  angleDeg: 180 + slotIdx * (360 / TOTAL_SLOTS),
  disc: startingLoadout[slotIdx] ?? null,
}));

const activeSlotIdx = Math.max(
  0,
  slots.findIndex((s) => s.disc?.id === initialDiscId)
);
---

<aside class="disc-changer" id="disc-deck" aria-label="6-disc changer">
  <div class="disc-changer-housing">
    <div class="disc-read-notch" aria-hidden="true">
      <span class="disc-read-led" id="disc-read-led" data-tone={slots[activeSlotIdx]?.disc?.discTone ?? 'silver'}></span>
      <span class="disc-read-arrow"></span>
    </div>

    <div
      class="disc-carousel"
      id="disc-carousel"
      style={`--carousel-angle:${-activeSlotIdx * 60}deg;`}
      role="radiogroup"
      aria-label="Choose a disc"
    >
      {slots.map(({ slotIdx, slotNumber, angleDeg, disc }) => (
        <div
          class:list={['disc-slot', { 'is-empty': !disc }]}
          data-slot-idx={slotIdx}
          data-slot-number={slotNumber}
          style={`--slot-angle:${angleDeg}deg;`}
        >
          {disc ? (
            <DiscCard disc={disc} slotIdx={slotIdx} active={slotIdx === activeSlotIdx} />
          ) : (
            <div class="disc-empty-tray" aria-hidden="true">
              <span class="disc-empty-spindle"></span>
              <span class="disc-empty-num">{slotNumber}</span>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="disc-center-console">
      <span class="disc-slot-readout" id="disc-slot-readout">
        {formatDiscSlot(activeSlotIdx)}
      </span>
      <button
        type="button"
        class="disc-change-btn"
        id="disc-change-btn"
        aria-label="Change disc"
        title="Next disc"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-2.64-6.36" />
          <polyline points="21 3 21 9 15 9" />
        </svg>
        <span>DISC</span>
      </button>
    </div>
  </div>

  {/* Every disc in the collection, ready for JS to drop into a slot when it's loaded from the CD book. */}
  {discs.map((disc) => (
    <template data-disc-template={disc.id}>
      <DiscCard disc={disc} />
    </template>
  ))}
  <template id="disc-empty-template">
    <div class="disc-empty-tray" aria-hidden="true">
      <span class="disc-empty-spindle"></span>
      <span class="disc-empty-num"></span>
    </div>
  </template>
</aside>
