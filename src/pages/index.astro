---
import '../styles/global.css';
import TimelineDial from '../components/TimelineDial.astro';
import IPod from '../components/IPod.astro';
import DiscDeck from '../components/DiscDeck.astro';
import { loadDiscs } from '../lib/discs';
import type { ClientDisc } from '../lib/types';

const discs = loadDiscs();
const initialDisc = discs[0];
const initialPlaylists = initialDisc.playlists;

const clientPayload: ClientDisc[] = discs.map((disc) => ({
  id: disc.id,
  ipodTheme: disc.ipodTheme,
  showTimelineDial: disc.showTimelineDial,
  playlists: disc.playlists.map((pl) => ({
    year: pl.year,
    monthShort: pl.monthShort,
    label: pl.label,
    trackCount: pl.trackCount,
    totalDurationText: pl.totalDurationText,
    tracks: pl.tracks.map((t) => ({
      title: t.title,
      artistText: t.artistText,
      durationText: t.durationText,
      ...(t.youtubeId ? { youtubeId: t.youtubeId } : {}),
    })),
  })),
}));

// Escape `<` so embedded JSON cannot prematurely close the <script> tag.
const safeJson = JSON.stringify(clientPayload).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>scrobbl</title>
    <meta name="description" content="Monthly playlist time machine." />
  </head>
  <body>
    <main class="studio-stage">
      <div class="top-right-controls">
        <a
          href="https://github.com/joyhchen/scrobbl/"
          target="_blank"
          rel="noopener noreferrer"
          class="source-link"
          aria-label="View source code on GitHub"
          title="View source on GitHub"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          <span>Source</span>
        </a>

        <button
          type="button"
          class="sound-toggle"
          id="sound-toggle"
          data-muted="false"
          aria-pressed="false"
          aria-label="Toggle dial and click-wheel sound effects"
          title="Toggle click sounds"
        >
          <svg class="icon-sound" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
          <svg class="icon-muted" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
      </div>

      <TimelineDial playlists={initialPlaylists} initialActiveIndex={0} />
      <IPod
        playlists={initialPlaylists}
        initialIndex={0}
        initialTheme={initialDisc.ipodTheme}
      />
      <DiscDeck discs={discs} initialDiscId={initialDisc.id} />
    </main>

    <script id="discs-data" type="application/json" set:html={safeJson} />
    <script>
      import '../scripts/timeMachine';
    </script>
  </body>
</html>
