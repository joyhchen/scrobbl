{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scrobbl",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "scrobbl-photos",
      "remote": true
    }
  ],
  "routes": [
    {
      "pattern": "joyhchen.com/music",
      "zone_name": "joyhchen.com"
    },
    {
      "pattern": "joyhchen.com/music/*",
      "zone_name": "joyhchen.com"
    }
  ]
}
